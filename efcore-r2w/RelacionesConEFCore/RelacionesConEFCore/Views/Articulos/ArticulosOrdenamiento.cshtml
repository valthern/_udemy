@model IEnumerable<RelacionesConEFCore.Models.Entities.Articulo>
@{
    ViewBag.Title = "Artículos Ordenados";
}

<h1 class="mb-4">Listado de Artículos (Ordenados por categoría y número)</h1>

<table class="table table-striped table-bordered">
    <thead class="table-dark">
        <tr>
            <th>Categoría</th>
            <th>Título</th>
            <th>Etiquetas</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var articulo in Model)
        {
            <tr>
                <td>@articulo.Categoria?.Nombre</td>
                <td>@articulo.Titulo</td>
                <td>
                    @string.Join(", ", articulo.Etiquetas.Select(e => e.Nombre))
                </td>
            </tr>
        }
    </tbody>
</table>

<a asp-action="Index" class="btn btn-secondary">Volver atrás</a>
