@model RelacionesConEFCore.Models.Entities.Articulo
@{
    ViewBag.Title = "Editar Artículo";
}

<h1 class="mb-4">@ViewBag.Title</h1>

<hr />

<form asp-action="Editar" method="post" class="mt-3">
    <div asp-validation-summary="All" class="text-danger"></div>

    <input type="hidden" asp-for="Id" />

    <div class="mb-3">
        <label asp-for="Titulo" class="form-label"></label>
        <input asp-for="Titulo" class="form-control" placeholder="Ingresa el nombre de la categoría" />
        <span asp-validation-for="Titulo" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Contenido" class="form-label"></label>
        <textarea asp-for="Contenido" class="form-control" placeholder="Ingrese contenido"></textarea>
        <span asp-validation-for="Contenido" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label class="form-label">Categorías</label>
        <select asp-for="CategoriaId" class="form-control" asp-items="@(new SelectList(ViewBag.Categorias, "Id", "Nombre", Model.CategoriaId))">
            <option value="">--Seleccione una Categoría--</option>
        </select>
    </div>

    <div class="mb-3">
        <label class="form-label">Etiquetas</label>
        @if (ViewBag.Etiquetas is not null)
        {
            @foreach (var etiqueta in ViewBag.Etiquetas)
            {
                <div class="form-check">
                    <input class="form-check-input" type="checkbox" name="etiquetasSeleccionadas" value="@etiqueta.Id" @(Model.Etiquetas.Any(e => e.Id == etiqueta.Id) ? "checked" : "") />
                    <label class="form-check-label">@etiqueta.Nombre</label>
                </div>
            }
        }
        else
        {
            <p class="text-muted">No hay etiquetas disponibles.</p>
        }
    </div>

    <button type="submit" class="btn btn-success">Guardar cambios</button>
    <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
</form>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
