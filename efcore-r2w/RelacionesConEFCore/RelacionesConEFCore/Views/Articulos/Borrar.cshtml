@model RelacionesConEFCore.Models.Entities.Articulo
@{
    ViewBag.Title = "Borrar Artículo";
}

<h1 class="mb-4">@ViewBag.Title</h1>
<h2>¿Está seguro que desea borrar este Artículo?</h2>

<hr />

<div class="card">
    <div class="card-body">
        <h4 class="card-title">@Model.Titulo</h4>
        <p>@Model.Contenido</p>
        <p><strong>Categoría:</strong> @Model.Categoria?.Nombre</p>
    </div>
</div>

<form asp-action="Borrar" method="post" class="mt-3">
    <input type="hidden" asp-for="Id" />
    <button type="submit" class="btn btn-danger">Borrar</button>
    <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
</form>