@* Index.cshtml *@
@model IEnumerable<RelacionesConEFCore.Models.Entities.Articulo>
@{
    ViewBag.Title = "Lista de Artículos";
}

<h1 class="mb-4">@ViewBag.Title</h1>

<p>
    <a asp-action="Crear" class="btn btn-primary">Nuevo Artículo</a>
    <a asp-action="ArticuloPorCategoria" class="btn btn-secondary">Filtrar por Categoría</a>
    <a asp-action="ArticulosOrdenamiento" class="btn btn-secondary">Artículos Ordenados</a>
    <a asp-action="Resumen" class="btn btn-secondary">Resumen</a>
    <a asp-action="Busqueda" class="btn btn-secondary">Buscar</a>
    <a asp-action="RecienteSQL" class="btn btn-secondary">Artículos Recientes (FromSqlRaw)</a>
    <a asp-action="ConComentarios" class="btn btn-secondary">Artículos con comentarios (LEFT JOIN)</a>
    <a asp-action="UsuariosConComentarios" class="btn btn-secondary">Usuarios con comentarios (RIGHT JOIN simulado)</a>
</p>

<table class="table table-striped table-bordered">
    <thead class="table-dark">
        <tr>
            <th>@Html.DisplayNameFor(model => model.Id)</th>
            <th>@Html.DisplayNameFor(model => model.Titulo)</th>
            <th>@Html.DisplayNameFor(model => model.Contenido)</th>
            <th>Categorías</th>
            <th>Etiquetas</th>
            <th>Comentarios</th>
            <th>Por categoría (SQL)</th>
            <th>Acciones</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var articulo in Model)
        {
            <tr>
                <td>@articulo.Id</td>
                <td>@articulo.Titulo</td>
                <td>@(articulo.Contenido.Length > 50 ? articulo.Contenido.Substring(0, 50) + "..." : articulo.Contenido)</td>
                <td>@articulo.Categoria?.Nombre</td>
                <td>
                    @if (articulo.Etiquetas is not null && articulo.Etiquetas.Any())
                    {
                        @string.Join(", ", articulo.Etiquetas.Select(e => e.Nombre))
                    }
                    else
                    {
                        <span class="text-muted">Sin etiquetas.</span>
                    }
                </td>
                <td>@(articulo.Comentarios?.Count ?? 0)</td>
                <td>
                    <!--
                        El nombre de la propiedad "asp-route-categoriaId" (la parte de categoriaId) debe coincidir con el nombre del parámetro
                        en el método "PorCategoriaSQL" (que es "int categoriaId") para poder enlazar el valor.
                    -->
                    <a asp-controller="Articulos" asp-action="PorCategoriaSQL" asp-route-categoriaId="@articulo.CategoriaId" class="btn btn-outline-primary btn-sm">Ver artículos</a>
                </td> 
                <td>
                    <a asp-action="Editar" asp-route-id="@articulo.Id" class="btn btn-sm btn-warning m-1">Editar</a>
                    <a asp-action="Detalle" asp-route-id="@articulo.Id" class="btn btn-sm btn-info m-1">Detalles</a>
                    <a asp-action="Borrar" asp-route-id="@articulo.Id" class="btn btn-sm btn-danger m-1">Eliminar</a>
                </td>
            </tr>
        }
    </tbody>
</table>
