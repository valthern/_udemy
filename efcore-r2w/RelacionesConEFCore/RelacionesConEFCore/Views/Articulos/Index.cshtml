@* Index.cshtml *@
@model IEnumerable<RelacionesConEFCore.Models.Entities.Articulo>
@{
    ViewBag.Title = "Lista de Artículos";
}

<h1 class="mb-4">@ViewBag.Title</h1>

<p>
    <a asp-action="Crear" class="btn btn-primary">Nuevo Artículo</a>
</p>

<table class="table table-striped table-bordered">
    <thead class="table-dark">
        <tr>
            <th>@Html.DisplayNameFor(model => model.Id)</th>
            <th>@Html.DisplayNameFor(model => model.Titulo)</th>
            <th>@Html.DisplayNameFor(model => model.Contenido)</th>
            <th>Categorías</th>
            <th>Etiquetas</th>
            <th>Comentarios</th>
            <th>Acciones</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Id</td>
                <td>@item.Titulo</td>
                <td>@(item.Contenido.Length > 50 ? item.Contenido.Substring(0, 50) + "..." : item.Contenido)</td>
                <td>@item.Categoria?.Nombre</td>
                <td>
                    @if (item.Etiquetas is not null && item.Etiquetas.Any())
                    {
                        @string.Join(", ", item.Etiquetas.Select(e => e.Nombre))
                    }
                    else
                    {
                        <span class="text-muted">Sin etiquetas.</span>
                    }
                </td>
                <td>@(item.Comentarios?.Count ?? 0)</td>
                <td>
                    <a asp-action="Editar" asp-route-id="@item.Id" class="btn btn-sm btn-warning">Editar</a>
                    <a asp-action="Detalle" asp-route-id="@item.Id" class="btn btn-sm btn-info">Detalles</a>
                    <a asp-action="Borrar" asp-route-id="@item.Id" class="btn btn-sm btn-danger">Eliminar</a>
                </td>
            </tr>
        }
    </tbody>
</table>
