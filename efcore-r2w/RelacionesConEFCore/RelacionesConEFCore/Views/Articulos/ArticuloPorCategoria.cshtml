@model IEnumerable<RelacionesConEFCore.Models.Entities.Articulo>
@{
    ViewBag.Title = "Artículos por Categoría";
}

<h1 class="mb-4">@ViewBag.Title</h1>

<form method="get" asp-action="ArticuloPorCategoría" class="mb-3">

    <label class="form-label">Filtrar por Categoría:</label>
    <select name="categoriaId" class="form-select" asp-items="@ViewBag.Categorias">
        <option value="">--Seleccione una Categoría--</option>
    </select>
    <button type="submit" class="btn btn-primary mt-2">Filtrar</button>

</form>

<table class="table table-striped table-bordered">
    <thead class="table-dark">
        <tr>
            <th>Título</th>
            <th>Categoría</th>
            <th>Etiquetas</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var articulo in Model)
        {
            <tr>
                <td>@articulo.Titulo</td>
                <td>@articulo.Categoria?.Nombre</td>
                <td>
                    @string.Join(", ", articulo.Etiquetas.Select(e => e.Nombre))
                </td>
            </tr>
        }
    </tbody>
</table>

<a asp-action="Index" class="btn btn-secondary">Volver atrás</a>
