@model IEnumerable<RelacionesConEFCore.Models.Entities.Categoria>
@{
    ViewBag.Title = "Lista de Categorías";
}

<h1 class="mb-4">@ViewBag.Title</h1>

<p>
    <a asp-action="Crear" class="btn btn-primary">Crear Categoría</a>
</p>

<table class="table table-striped table-bordered">
    <thead class="table-dark">
        <tr>
            <th>@Html.DisplayNameFor(model => model.Id)</th>
            <th>@Html.DisplayNameFor(model => model.Nombre)</th>
            <th>Acciones</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var categoria in Model)
        {
            <tr>
                <td>@categoria.Id</td>
                <td>@categoria.Nombre</td>
                <td>
                    <a asp-action="Editar" asp-route-id="@categoria.Id" class="btn btn-sm btn-warning">Editar</a>
                    <a asp-action="Detalle" asp-route-id="@categoria.Id" class="btn btn-sm btn-info">Detalles</a>
                    <a asp-action="Borrar" asp-route-id="@categoria.Id" class="btn btn-sm btn-danger">Eliminar</a>
                </td>
            </tr>
        }
    </tbody>
</table>
