@model RelacionesConEFCore.Models.Entities.PerfilUsuario
@{
    ViewBag.Title = "Editar Perfil de Usuario";
}

<h1 class="mb-4">@ViewBag.Title</h1>

<form class="mt-3" asp-action="Editar" method="post">

    <div asp-validation-summary="All" class="text-danger"></div>
    
    <input type="hidden" asp-for="UsuarioId" />

    <div class="mb-3">
        <label class="form-label"><strong>@Model.Usuario.Nombre</strong></label>
    </div>
    
    <div class="mb-3">
        <label asp-for="Biografia" class="form-label"></label>
        <input asp-for="Biografia" class="form-control" placeholder="Ingresa la biografía del usuario" />
        <span asp-validation-for="Biografia" class="text-danger"></span>
    </div>
    
    <div class="mb-3">
        <label asp-for="FotoUrl" class="form-label"></label>
        <input asp-for="FotoUrl" class="form-control" placeholder="Ingresa la URL de la foto del usuario" />
        <span asp-validation-for="FotoUrl" class="text-danger"></span>
    </div>
    
    <button type="submit" class="btn btn-primary">Guardar cambios</button>
    <a asp-action="Index" class="btn btn-secondary">Cancelar</a>

</form>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
