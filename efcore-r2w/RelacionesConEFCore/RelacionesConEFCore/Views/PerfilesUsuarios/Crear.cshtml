@model RelacionesConEFCore.Models.Entities.PerfilUsuario
@{
    ViewBag.Title = "Nuevo Perfil de Usuario";
}

<h1 class="mb-4">@ViewBag.Title</h1>

<form class="mt-3" asp-action="Crear" method="post">

    <div asp-validation-summary="All" class="text-danger"></div>

    <div class="mb-3">
        <label class="form-label">Usuario</label>
        <select asp-for="UsuarioId" class="form-select" asp-items="@(new SelectList(ViewBag.Usuarios, "Id", "Nombre"))">
            <option value="">--Seleccione un Usuario--</option>
        </select>
        <span asp-validation-for="UsuarioId" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Biografia" class="form-label"></label>
        <textarea asp-for="Biografia" class="form-control" placeholder="Ingresa la biografía"></textarea>
        <span asp-validation-for="Biografia" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="FotoUrl" class="form-label"></label>
        <input asp-for="FotoUrl" class="form-control" placeholder="Ingresa la URL de la foto" />
        <span asp-validation-for="FotoUrl" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-success">Guardar</button>
    <a asp-action="Index" class="btn btn-secondary">Cancelar</a>

</form>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
