@model RelacionesConEFCore.Models.Entities.Comentario
@{
    ViewBag.Title = "Detalle de Comentario";
}

<h1>@ViewBag.Title</h1>

<div class="card">
    <div class="card-body">
        <p><strong>Texto: </strong>@Model.Texto</p>
        <p><strong>ID: </strong>@Model.Id</p>
        <p><strong>Usuario: </strong>@Model.Usuario.Nombre</p>
        <p><strong>Artículo: </strong>@(Model.Articulo.Titulo.Length > 50 ? Model.Articulo.Titulo.Substring(0, 50) + "..." : Model.Articulo.Titulo)</p>
        <div class="mb-3">
            <input asp-for="Aprobado" class="form-check-input" type="checkbox" disabled />
            <label asp-for="Aprobado" class="form-label"></label>
        </div>
    </div>
</div>

<a asp-action="Index" class="btn btn-secondary mt-3">Volver</a>
