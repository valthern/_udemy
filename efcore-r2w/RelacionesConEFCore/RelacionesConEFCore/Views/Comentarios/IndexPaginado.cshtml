@model RelacionesConEFCore.DTOs.ComentariosIndexDTO
@{
    ViewBag.Title = "Comentarios (paginados)";
}

<h1 class="mb-4">@ViewBag.Title</h1>

<form method="get" asp-action="IndexPaginado" class="row g-2 mb-3">

    <div class="col-auto">
        <label for="tamanoPagina" class="col-form-label">Tamaño de página:</label>
    </div>
    <div class="col-auto">
        <select id="tamanoPagina" name="tamanoPagina" class="form-select" onchange="this.form.submit()">
            <option value="5" selected="@(Model.TamanoPagina == 5 ? "selected" : "")">5</option>
            <option value="10" selected="@(Model.TamanoPagina == 10 ? "selected" : "")">10</option>
            <option value="20" selected="@(Model.TamanoPagina == 20 ? "selected" : "")">20</option>
        </select>
    </div>

    <input type="hidden" name="pagina" value="1" />

</form>

<table class="table table-striped table-bordered">
    <thead class="table-dark">
        <tr>
            <th>Texto</th>
            <th>Usuario</th>
            <th>Artículo</th>
            <th>¿Está aprobado?</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var comentario in Model.Comentarios)
        {
            <tr>
                <td>@comentario.Texto</td>
                <td>@comentario.Usuario.Nombre</td>
                <td>@comentario.Articulo.Titulo</td>
                <td>@(comentario.Aprobado ? "Sí" : "No")</td>
            </tr>
        }
    </tbody>
</table>

<!-- Paginación -->
<nav aria-label="Paginación de comentarios">
    <ul class="pagination justify-content-center">
        <li class="page-item @(Model.PaginaActual <= 1 ? "disabled" : "")">
            <a class="page-link" asp-action="IndexPaginado" asp-route-pagina="@(Model.PaginaActual - 1)" asp-route-tamanoPagina="@Model.TamanoPagina">
                Anterior
            </a>
        </li>

        @{
            // Mostrar un rango compacto de páginas alrededor de la página actual
            int inicio = Math.Max(1, Model.PaginaActual - 2);
            int fin = Math.Min(Model.TotalPaginas, Model.PaginaActual + 2);

            // Asegurar 5 botones de página visibles si es posible
            while (fin - inicio < 4 && fin < Model.TotalPaginas) fin++;
            while (fin - inicio < 4 && inicio > 1) inicio--;
        }

        @for (int p = inicio; p <= fin; p++)
        {
            <li class="page-item @(p == Model.PaginaActual ? "active" : "")">
                <a class="page-link" asp-action="IndexPaginado" asp-route-pagina="@p" asp-route-tamanoPagina="@Model.TamanoPagina">@p</a>
            </li>
        }

        <!-- Botón "Siguiente" -->
        <li class="page-item @(Model.PaginaActual >= Model.TotalPaginas ? "disabled" : "")">
            <a class="page-link" asp-action="IndexPaginado" asp-route-pagina="@(Model.PaginaActual + 1)" asp-route-tamanoPagina="@Model.TamanoPagina">
                Siguiente
            </a>
        </li>
    </ul>
</nav>

<p class="text-muted">
    Mostrando página @Model.PaginaActual de @Model.TotalPaginas páginas
    (@Model.TotalRegistros registro@(Model.TotalRegistros == 1 ? "" : "s") en total).
</p>